{
  "name": "gwan-design-system",
  "version": "1.0.8",
  "description": "✨ A reusable component library for Next.js projects.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "next dev",
    "prebuild": "echo \"NEXT_PUBLIC_APP_VERSION=$(git describe --tags --abbrev=0)\" > .env.local",
    "build": "next build",
    "build:lib": "tsup",
    "prepack": "npm run build:lib",
    "prepare": "npm run build:lib",
    "start": "next start",
    "lint": "eslint .",
    "test": "TZ=UTC VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run",
    "test:watch": "TZ=UTC VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "gray-matter": "^4.0.3",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "reading-time": "^1.5.0",
    "rehype-pretty-code": "^0.14.3",
    "remark-gfm": "^4.0.1",
    "resend": "^6.35.0",
    "shiki": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.0.7",
    "jsdom": "^30.1.3",
    "next": "^16.4.3",
    "postcss": "^8.5.32",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.1.17",
    "tsup": "^8.5.1",
    "tw-colors": "^3.3.2",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "6.1.5"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "keywords": [
    "nextjs",
    "react",
    "tailwindcss",
    "typescript",
    "component-library",
    "design-system"
  ],
  "author": "Nimesh Fonseka",
  "license": "MIT"
}
